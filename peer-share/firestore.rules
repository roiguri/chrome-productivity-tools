rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Relayed messages. The sender writes; only the addressed recipient
    // can read it back or mark it delivered.
    match /messages/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.to == request.auth.uid;
    }

    // chrome.gcm registration tokens. Owner writes their own; any
    // authenticated user may read (needed so a sender's flow / the push
    // function can resolve a recipient's token). The token is a routing id,
    // not a credential.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
