rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Payloads are stored under the recipient's uid. Any authenticated user
    // may upload (the sender), but only the addressed recipient may read.
    match /messages/{uid}/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
