{
  "manifest_version": 3,
  "name": "Peer Share",
  "version": "1.0.0",
  "description": "Send a screenshot of the current tab, a file, or text straight to a paired peer's browser.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "notifications",
    "alarms",
    "gcm"
  ],

  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  }
}
